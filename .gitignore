# 构建产物
bin/
obj/
[Dd]ebug/
[Rr]elease/
/artifacts/
*.user
*.suo
.vs/
.idea/
.vscode/

# 本地运行数据（不纳入版本控制）
# 注意：这些规则必须锚定到仓库根目录。
# 未锚定的 "data/" 在 Windows 上大小写不敏感，会连同 src/**/Data（Migrations 等）一起被忽略，
# 导致新克隆缺少 EF 迁移与 DbContext，无法编译、无法建库。
/App_Data/
/data/
*.db
*.db-shm
*.db-wal

# 源码中的 Data 目录必须纳入版本控制
!src/**/Data/
!src/**/Data/**

# 生成的申请材料
生成材料/
*.zip
!samples/**/*.zip

# 测试与覆盖率
TestResults/
coverage*.json
coverage*.xml
*.coverage

# 日志
logs/
*.log
*.log.err

# 本地诊断工具与临时产物
.tools/
.verify-*.zip
