@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICaseApiClient Api

<PageTitle>知识产权申请材料工具</PageTitle>

<div class="page-head">
    <div>
        <h1>选择要书写的申请材料</h1>
        <div class="sub">两条流程各自独立：材料类型、页面构成、前置门禁与产物清单都不相同。</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="card">
        <div class="empty">正在加载材料流程……</div>
    </div>
}
else
{
    <div class="entry-grid">
        @foreach (var flow in _flows)
        {
            var current = flow;
            <a class="entry-card @(current.Kind == "Patent" ? "entry-patent" : "entry-soft")" href="@current.WorkspacePath">
                <div class="entry-kind">@current.ShortName</div>
                <div class="entry-title">@current.DisplayName</div>
                <p class="entry-desc">@current.Summary</p>
                <div class="entry-line">
                    <span class="entry-label">产出</span>
                    <span class="entry-value">@current.Deliverables</span>
                </div>
                <div class="entry-go">进入 →</div>
            </a>
        }
    </div>

    <div class="card" style="margin-top:18px">
        <h2>两条流程的差别</h2>
        <table>
            <thead>
            <tr>
                <th style="width:140px">环节</th>
                <th>软著登记</th>
                <th>专利申请</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td class="small">事实来源</td>
                <td class="small">项目画像 + 申请信息</td>
                <td class="small">项目画像 + 技术交底书（唯一真源）</td>
            </tr>
            <tr>
                <td class="small">前置门禁</td>
                <td class="small">项目画像 → 申请信息 → 代码范围 → 草稿</td>
                <td class="small">项目画像 → 交底书与权利要求就绪 → 草稿</td>
            </tr>
            <tr>
                <td class="small">代码范围</td>
                <td class="small">必须勾选，代码鉴别材料逐行摘自真实源码</td>
                <td class="small">不需要，专利申请文件不含代码鉴别材料</td>
            </tr>
            <tr>
                <td class="small">产出文件</td>
                <td class="small">申请表信息、操作手册、代码鉴别材料、证据清单、校验报告</td>
                <td class="small">权利要求书、说明书、摘要、技术交底书</td>
            </tr>
            <tr>
                <td class="small">需要人工判断</td>
                <td class="small">著作权人、权属关系、开发方式等法律事实</td>
                <td class="small">保护范围、新颖性、创造性、充分公开（须由专利代理人复核）</td>
            </tr>
            </tbody>
        </table>
    </div>
}

@code {
    private List<MaterialFlowDto> _flows = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _flows = (await Api.GetFlowsAsync(CancellationToken.None)).ToList();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}

<style>
    .entry-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }

    .entry-card {
        display: block; padding: 24px 26px; border-radius: var(--radius);
        border: 1px solid var(--line); background: var(--panel);
        color: var(--text); position: relative; overflow: hidden;
        box-shadow: var(--shadow-1);
        transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
    }
    .entry-card:hover {
        text-decoration: none; transform: translateY(-3px);
        box-shadow: var(--shadow-2); border-color: var(--line-strong);
    }
    .entry-card::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 4px; }

    .entry-soft::before { background: var(--accent); }
    .entry-patent::before { background: var(--teal); }
    .entry-soft:hover { border-color: var(--accent-border); }
    .entry-patent:hover { border-color: var(--teal-border); }

    .entry-kind {
        display: inline-block; font-size: 11.5px; font-weight: 600; letter-spacing: .08em;
        padding: 2px 9px; border-radius: 999px; border: 1px solid transparent;
    }
    .entry-soft .entry-kind { color: var(--accent); background: var(--accent-soft); border-color: var(--accent-border); }
    .entry-patent .entry-kind { color: var(--teal); background: var(--teal-soft); border-color: var(--teal-border); }

    .entry-title { font-size: 22px; font-weight: 700; margin: 12px 0 8px; letter-spacing: -.01em; }
    .entry-desc { font-size: 13px; color: var(--muted); margin: 0 0 16px; min-height: 46px; line-height: 1.75; }

    .entry-line { font-size: 12.5px; color: var(--text-2); border-top: 1px dashed var(--line); padding-top: 11px; }
    .entry-label { display: inline-block; min-width: 34px; color: var(--muted); font-weight: 600; }
    .entry-value { display: inline-block; }

    .entry-go { margin-top: 16px; font-size: 13px; font-weight: 600; }
    .entry-soft .entry-go { color: var(--accent); }
    .entry-patent .entry-go { color: var(--teal); }

    @@media (max-width: 860px) {
        .entry-grid { grid-template-columns: 1fr; }
    }
</style>
