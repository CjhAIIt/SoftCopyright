@page "/register"
@attribute [AllowAnonymous]

<PageTitle>注册 · 知识产权申请材料工具</PageTitle>

<div class="auth-wrap">
    <div class="card auth-card">
        <h1>注册本地账号</h1>
        <p class="muted small">账号只保存在本机数据库中，密码以 PBKDF2 派生值存储，不保存明文。</p>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="alert alert-danger">@Error</div>
        }

        <form method="post" action="/api/auth/register">
            <AntiforgeryToken />

            <label class="field">
                <span>登录名</span>
                <input type="text" name="userName" required minlength="3" maxlength="40" autocomplete="username" />
                <span class="hint">3 到 40 个字符，不能包含空格。</span>
            </label>

            <label class="field">
                <span>显示名称</span>
                <input type="text" name="displayName" maxlength="100" autocomplete="nickname" />
                <span class="hint">可留空，默认与登录名相同。</span>
            </label>

            <label class="field">
                <span>密码</span>
                <input type="password" name="password" required minlength="8" autocomplete="new-password" />
                <span class="hint">至少 8 位。</span>
            </label>

            <div class="row">
                <button type="submit" class="btn btn-primary">注册并进入引导</button>
                <a class="btn" href="/login">已有账号，去登录</a>
            </div>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}

<style>
    .auth-wrap { display: flex; justify-content: center; padding-top: 24px; }
    .auth-card { width: 100%; max-width: 420px; }
    .auth-card h1 { font-size: 19px; margin: 0 0 6px; }
</style>
