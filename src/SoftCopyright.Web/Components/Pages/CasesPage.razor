@page "/"
@rendermode InteractiveServer
@inject ICaseApiClient Api
@inject NavigationManager Nav

<div class="page-head">
    <div>
        <h1>申请案例</h1>
        <div class="sub">导入真实代码仓库，生成可核对、可追溯的软件著作权申请材料。</div>
    </div>
    <div class="actions">
        <select @bind="_materialKind" style="width:150px">
            <option value="SoftwareCopyright">软著登记</option>
            <option value="Patent">专利申请</option>
        </select>
        <input type="text" placeholder="新案例名称（可留空）" @bind="_newName" style="width:200px" />
        <button class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync">新建案例</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card">
    @if (_loading)
    {
        <div class="empty">正在加载案例列表……</div>
    }
    else if (_cases.Count == 0)
    {
        <div class="empty">
            还没有申请案例。点击右上角「新建案例」开始导入代码仓库。
        </div>
    }
    else
    {
        <table>
            <thead>
            <tr>
                <th>案例名称</th>
                <th>软件名称</th>
                <th>当前阶段</th>
                <th>状态</th>
                <th>确认进度</th>
                <th>更新时间</th>
                <th style="width:150px">操作</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in _cases)
            {
                <tr>
                    <td><a href="/cases/@item.Id/import">@item.Name</a></td>
                    <td>
                        @item.SoftwareFullName
                        <div class="small"><span class="badge badge-muted">@(item.MaterialKind == MaterialKind.Patent ? "专利申请" : "软著登记")</span></div>
                    </td>
                    <td><span class="badge @(StageBadge(item.Stage))">@item.StageText</span></td>
                    <td class="small muted">@item.StatusMessage</td>
                    <td class="small">@item.ConfirmedCount / @item.TotalConfirmations</td>
                    <td class="small muted">@item.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm" href="/cases/@item.Id/analysis">打开</a>
                        <button class="btn btn-sm btn-danger" disabled="@_busy" @onclick="() => AskDelete(item)">删除</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@if (_pendingDelete is not null)
{
    <div class="card">
        <div class="alert alert-warn">
            确认删除案例「@_pendingDelete.Name」？该操作会移除上传的压缩包、扫描证据、确认记录与已生成的材料文件，且无法撤销。
        </div>
        <div class="row">
            <button class="btn btn-danger" disabled="@_busy" @onclick="DeleteAsync">确认删除</button>
            <button class="btn" disabled="@_busy" @onclick="() => _pendingDelete = null">取消</button>
        </div>
    </div>
}

@code {
    private List<CaseSummaryDto> _cases = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _newName;
    private MaterialKind _materialKind = MaterialKind.SoftwareCopyright;
    private CaseSummaryDto? _pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _cases = (await Api.GetCasesAsync(CancellationToken.None)).ToList();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        _busy = true;
        try
        {
            var created = await Api.CreateCaseAsync(_newName, _materialKind, CancellationToken.None);
            Nav.NavigateTo($"/cases/{created.Id}/import");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskDelete(CaseSummaryDto item) => _pendingDelete = item;

    private async Task DeleteAsync()
    {
        if (_pendingDelete is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.DeleteCaseAsync(_pendingDelete.Id, CancellationToken.None);
            _pendingDelete = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StageBadge(CaseStage stage) => stage switch
    {
        CaseStage.Failed => "badge-danger",
        CaseStage.Archived or CaseStage.PackageReady => "badge-ok",
        CaseStage.AnalysisReady or CaseStage.DraftReady => "badge-info",
        _ => "badge-muted"
    };
}
