@page "/cases/{CaseId:guid}/applicant"
@rendermode InteractiveServer
@inject ICaseApiClient Api

<CaseHeader CaseId="CaseId" ActiveTab="applicant" />

<div class="page-head">
    <div>
        <h1>申请信息</h1>
        <div class="sub">带 <span class="required">*</span> 的字段为必填。法律与权属字段不会由系统预填，必须由申请人填写并确认。</div>
    </div>
    <div class="actions">
        <button class="btn" disabled="@_busy" @onclick="SaveAsync">保存</button>
        <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAndConfirmAsync">保存并确认</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-ok">@_message</div>
}

<div class="card">
    <div class="grid-2">
        <label class="field">
            <span>软件全称 <span class="required">*</span></span>
            <input type="text" @bind="_form.SoftwareFullName" />
            <span class="hint">建议与代码仓库中的项目名称保持一致。</span>
        </label>
        <label class="field">
            <span>软件简称</span>
            <input type="text" @bind="_form.SoftwareAbbreviation" />
            <span class="hint">如适用。</span>
        </label>

        <label class="field">
            <span>版本号 <span class="required">*</span></span>
            <input type="text" @bind="_form.VersionNumber" />
            <span class="hint">请按官方最新要求确认版本写法。</span>
        </label>
        <label class="field">
            <span>著作权人 <span class="required">*</span></span>
            <input type="text" @bind="_form.CopyrightOwner" />
            <span class="hint">必须由申请人填写，系统不会推断。</span>
        </label>

        <label class="field">
            <span>开发方式 <span class="required">*</span></span>
            <input type="text" @bind="_form.DevelopmentMode" placeholder="例如：独立开发" />
            <span class="hint">法律事实，必须由申请人确认。</span>
        </label>
        <label class="field">
            <span>权利取得方式 <span class="required">*</span></span>
            <input type="text" @bind="_form.RightsAcquisitionMethod" placeholder="例如：原始取得" />
            <span class="hint">法律事实，必须由申请人确认。</span>
        </label>

        <label class="field">
            <span>开发完成日期</span>
            <input type="text" @bind="_form.CompletionDate" placeholder="YYYY-MM-DD" />
            <span class="hint">请按官方最新要求确认。</span>
        </label>
        <label class="field">
            <span>首次发表状态</span>
            <input type="text" @bind="_form.FirstPublicationStatus" placeholder="例如：未发表" />
        </label>

        <label class="field">
            <span>首次发表日期</span>
            <input type="text" @bind="_form.FirstPublicationDate" placeholder="YYYY-MM-DD（未发表可留空）" />
        </label>
        <label class="field">
            <span>源程序量 <span class="required">*</span></span>
            <input type="text" @bind="_form.SourceProgramAmount" placeholder="例如：3200 行" />
            <span class="hint">用于与材料中的实际代码行数交叉核对。</span>
        </label>

        <label class="field">
            <span>开发环境 <span class="required">*</span></span>
            <input type="text" @bind="_form.DevelopmentEnvironment" placeholder="例如：Windows 11 + .NET 10" />
        </label>
        <label class="field">
            <span>运行环境 <span class="required">*</span></span>
            <input type="text" @bind="_form.RuntimeEnvironment" placeholder="例如：Windows 10 及以上" />
        </label>

        <label class="field">
            <span>编程语言 <span class="required">*</span></span>
            <input type="text" @bind="_form.ProgrammingLanguages" placeholder="例如：C#、JavaScript" />
        </label>
        <label class="field">
            <span>字段来源</span>
            <input type="text" value="@_sourceSummary" disabled />
            <span class="hint">来源由系统自动记录，无法手工修改。</span>
        </label>
    </div>

    <label class="field">
        <span>功能简介 <span class="required">*</span></span>
        <textarea @bind="_form.FunctionSummary" placeholder="简述软件的主要功能与用途"></textarea>
    </label>

    @if (_sources.Count > 0)
    {
        <details>
            <summary class="small muted">查看字段来源明细</summary>
            <table>
                <tbody>
                @foreach (var entry in _sources)
                {
                    <tr>
                        <td style="width:220px">@entry.Key</td>
                        <td class="small">@entry.Value</td>
                    </tr>
                }
                </tbody>
            </table>
        </details>
    }
</div>

@code {
    [Parameter] public Guid CaseId { get; set; }

    private ApplicantForm _form = new();

    private Dictionary<string, string> _sources = new();
    private bool _busy;
    private string? _error;
    private string? _message;

    private string _sourceSummary => _sources.Count == 0 ? "尚未保存" : string.Join("、", _sources.Values.Distinct());

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var info = await Api.GetApplicantInfoAsync(CaseId, CancellationToken.None);
            if (info is null)
            {
                return;
            }

            _form = new ApplicantForm
            {
                SoftwareFullName = info.SoftwareFullName,
                SoftwareAbbreviation = info.SoftwareAbbreviation,
                VersionNumber = info.VersionNumber,
                CopyrightOwner = info.CopyrightOwner,
                DevelopmentMode = info.DevelopmentMode,
                RightsAcquisitionMethod = info.RightsAcquisitionMethod,
                CompletionDate = info.CompletionDate,
                FirstPublicationStatus = info.FirstPublicationStatus,
                FirstPublicationDate = info.FirstPublicationDate,
                DevelopmentEnvironment = info.DevelopmentEnvironment,
                RuntimeEnvironment = info.RuntimeEnvironment,
                ProgrammingLanguages = info.ProgrammingLanguages,
                SourceProgramAmount = info.SourceProgramAmount,
                FunctionSummary = info.FunctionSummary,
                ExpectedRowVersion = info.RowVersion
            };

            _sources = new Dictionary<string, string>(info.FieldSources);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var request = new UpdateApplicantInfoRequest(
                _form.SoftwareFullName,
                _form.SoftwareAbbreviation,
                _form.VersionNumber,
                _form.CopyrightOwner,
                _form.DevelopmentMode,
                _form.RightsAcquisitionMethod,
                _form.CompletionDate,
                _form.FirstPublicationStatus,
                _form.FirstPublicationDate,
                _form.DevelopmentEnvironment,
                _form.RuntimeEnvironment,
                _form.ProgrammingLanguages,
                _form.SourceProgramAmount,
                _form.FunctionSummary,
                _form.ExpectedRowVersion);

            var saved = await Api.SaveApplicantInfoAsync(CaseId, request, CancellationToken.None);
            _form.ExpectedRowVersion = saved.RowVersion;
            _sources = new Dictionary<string, string>(saved.FieldSources);
            _message = "申请信息已保存。修改后下游确认与已生成材料需要重新确认。";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAndConfirmAsync()
    {
        await SaveAsync();
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.ConfirmAsync(CaseId, "ApplicantInfo", "在「申请信息」页确认", CancellationToken.None);
            _message = "申请信息已保存并确认，可以继续选择代码范围。";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
