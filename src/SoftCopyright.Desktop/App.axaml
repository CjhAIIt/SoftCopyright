<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SoftCopyright.Desktop.App"
             RequestedThemeVariant="Default">

  <!-- 设计令牌：与 Web 端同一套视觉语义，浅色/深色两套取值，切换主题即时生效。 -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBgBrush" Color="#FFF4F6FA" />
          <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="PanelAltBgBrush" Color="#FFF7F9FC" />
          <SolidColorBrush x:Key="BorderBrush" Color="#FFE2E7EF" />
          <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFCBD3E0" />
          <SolidColorBrush x:Key="TextBrush" Color="#FF16202E" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#FF66748A" />
          <SolidColorBrush x:Key="AccentBrush" Color="#FF4F46E5" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEDE9FE" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#FFC9C1F7" />
          <SolidColorBrush x:Key="OkBrush" Color="#FF15803D" />
          <SolidColorBrush x:Key="OkSoftBrush" Color="#FFDCFCE7" />
          <SolidColorBrush x:Key="OkBorderBrush" Color="#FFA7E3C0" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FFB45309" />
          <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFFEF3C7" />
          <SolidColorBrush x:Key="WarnBorderBrush" Color="#FFF2D08A" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FFDC2626" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFFEE2E2" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFF4B4B4" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBgBrush" Color="#FF0E1117" />
          <SolidColorBrush x:Key="PanelBgBrush" Color="#FF161A22" />
          <SolidColorBrush x:Key="PanelAltBgBrush" Color="#FF1C212B" />
          <SolidColorBrush x:Key="BorderBrush" Color="#FF262C38" />
          <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF39424F" />
          <SolidColorBrush x:Key="TextBrush" Color="#FFE8ECF3" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#FF93A0B4" />
          <SolidColorBrush x:Key="AccentBrush" Color="#FF8B7CF8" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#FF11131A" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF262347" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#FF3E3768" />
          <SolidColorBrush x:Key="OkBrush" Color="#FF4ADE80" />
          <SolidColorBrush x:Key="OkSoftBrush" Color="#FF12321F" />
          <SolidColorBrush x:Key="OkBorderBrush" Color="#FF1E5638" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FFFBBF24" />
          <SolidColorBrush x:Key="WarnSoftBrush" Color="#FF3A2C0C" />
          <SolidColorBrush x:Key="WarnBorderBrush" Color="#FF63451A" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FFF87171" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#FF3B1414" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#FF6B2626" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SoftCopyright.Desktop/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
