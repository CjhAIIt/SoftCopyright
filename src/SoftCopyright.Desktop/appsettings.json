{
  "App": {
    "InstanceName": "知识产权申请材料工具（桌面版）",
    "StatusNote": "材料仅供申请准备参考，最终登记与签章由申请人在官方系统自行完成"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Storage": {
    "DataRoot": ""
  },
  "Scan": {
    "MaxArchiveBytes": 52428800,
    "MaxEntryCount": 20000,
    "MaxTotalExtractedBytes": 524288000,
    "MaxFileBytes": 20971520,
    "MaxPathDepth": 32,
    "MaxCompressionRatio": 100,
    "CompressionRatioMinBytes": 1048576
  },
  "MaterialRules": {
    "Version": "2026.11-v1",
    "Source": "本工具内置工程配置，非官方权威解释，请按官方最新要求核对。",
    "CodeMaterial": {
      "LinesPerPage": 50,
      "TargetPages": 30,
      "IncludeFileBoundaryMarkers": true
    },
    "Layout": {
      "BodyFontSizeHalfPoints": 24,
      "LineSpacing": 312,
      "ShowPageNumbers": true
    }
  },
  "GitImport": {
    "AllowedHosts": [ "github.com", "gitee.com", "gitlab.com" ],
    "AllowAnyHost": false,
    "AllowLocalFileUrls": false,
    "TimeoutSeconds": 600,
    "Shallow": true,
    "MaxWorkingTreeSizeMb": 512,
    "AccessTokenEnvironmentVariable": "SOFTCOPYRIGHT_GIT_TOKEN",
    "GitExecutablePath": ""
  },
  "Ai": {
    "Provider": "rule-based",
    "BaseUrl": "",
    "Model": "",
    "ApiKeyEnvironmentVariable": "SOFTCOPYRIGHT_AI_APIKEY",
    "TimeoutSeconds": 60,
    "MaxEvidenceItems": 60,
    "MaxEvidenceBytes": 204800,
    "MaxItemBytes": 8192,
    "MaxCodeHeadLines": 40
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
