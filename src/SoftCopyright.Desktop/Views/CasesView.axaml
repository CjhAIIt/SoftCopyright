<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftCopyright.Desktop.ViewModels"
             x:Class="SoftCopyright.Desktop.Views.CasesView"
             x:DataType="vm:CasesViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="案例" Classes="title" />
                <TextBlock Classes="muted"
                           Text="案例、申请信息与材料全部保存在本机，不需要服务器；软著登记与专利申请两条流程各自独立。"  TextWrapping="Wrap"/>
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="新建案例" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewCaseName}"
                                 PlaceholderText="新案例名称（可留空）" />
                        <ComboBox Grid.Column="1"
                                  Width="150"
                                  Margin="10,0,0,0"
                                  ItemsSource="{Binding KindOptions}"
                                  SelectedItem="{Binding NewCaseKind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionItem">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Classes="primary"
                                Margin="10,0,0,0"
                                Content="新建案例"
                                Command="{Binding CreateCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="本机案例" Classes="section" />
                        <CheckBox Grid.Column="1"
                                  Content="显示专利案例"
                                  IsChecked="{Binding ShowPatentCases}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Cases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CaseRow">
                                <Border Classes="soft" Margin="0,0,0,8" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
                                        <Border Grid.Row="0" Grid.Column="1" Classes="badge info">
                                            <TextBlock Text="{Binding KindText}" />
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Margin="0,5,0,0"
                                                   Text="{Binding StatusMessage}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Grid.Row="2" Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Border Classes="badge ok">
                                                <TextBlock Text="{Binding StageText}" />
                                            </Border>
                                            <TextBlock Classes="muted" Text="{Binding UpdatedText}"  TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Content="打开" Command="{Binding OpenCommand}" />
                                            <Button Classes="danger" Content="删除" Command="{Binding DeleteCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="muted"
                               Text="还没有案例。先在上方新建一个，再导入代码仓库。"
                               IsVisible="{Binding !HasCases}"  TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
