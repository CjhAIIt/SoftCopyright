<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SoftCopyright.Desktop.ViewModels"
             x:Class="SoftCopyright.Desktop.Views.MaterialsView"
             x:DataType="vm:MaterialsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="材料与导出" Classes="title" />
                <TextBlock Classes="muted"
                           Text="校验结果只表示本工具自动化规则的检查结论，不代表登记审查结论；材料需由申请人在官方系统自行提交与签章。"  TextWrapping="Wrap"/>
            </StackPanel>

            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Summary}" Classes="muted" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Content="执行校验" Command="{Binding ValidateCommand}" />
                    <Button Grid.Column="2" Classes="primary" Margin="10,0,0,0" Content="生成材料" Command="{Binding GenerateCommand}" />
                </Grid>
            </Border>

            <Border Classes="card" IsVisible="{Binding Validations.Count}">
                <StackPanel Spacing="8">
                    <TextBlock Text="校验结果" Classes="section" />
                    <ItemsControl ItemsSource="{Binding Validations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ValidationRow">
                                <Border Classes="soft" Margin="0,0,0,6" Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding RuleId}"
                                                   Classes="muted"
                                                   FontSize="11.5"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold" />
                                        <Border Grid.Row="0" Grid.Column="2" Classes="badge ok">
                                            <TextBlock Text="{Binding LevelText}" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="{Binding Message}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Artifacts.Count}">
                <StackPanel Spacing="8">
                    <TextBlock Text="已生成的产物" Classes="section" />
                    <ItemsControl ItemsSource="{Binding Artifacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArtifactRow">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" />
                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" Classes="muted" Margin="10,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="muted" Margin="10,0,0,0" />
                                    <Button Grid.Column="3" Content="导出" Margin="10,0,0,0"
                                            Command="{Binding ExportCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
