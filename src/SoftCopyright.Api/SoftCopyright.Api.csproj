<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>softcopyright-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoftCopyright.Domain\SoftCopyright.Domain.csproj" />
    <ProjectReference Include="..\SoftCopyright.Application\SoftCopyright.Application.csproj" />
    <ProjectReference Include="..\SoftCopyright.ProjectScan\SoftCopyright.ProjectScan.csproj" />
    <ProjectReference Include="..\SoftCopyright.AI\SoftCopyright.AI.csproj" />
    <ProjectReference Include="..\SoftCopyright.Documents\SoftCopyright.Documents.csproj" />
    <ProjectReference Include="..\SoftCopyright.Infrastructure\SoftCopyright.Infrastructure.csproj" />
    <ProjectReference Include="..\SoftCopyright.Web\SoftCopyright.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      框架静态资源包：提供 _framework/blazor.web.js。
      Blazor 组件位于独立的 Razor 类库时，SDK 不会自动引入该包，
      缺失会导致页面只做服务端渲染、交互全部失效（按钮无响应）。
    -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" />
    <!-- 仅用于开发期生成 EF Core 迁移，不进入发布产物 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="All" />
  </ItemGroup>

</Project>
